_screen.fontname = 'AnsanaUPC,20'


set default to "D:\visual studio\Vfp98\visual foxro for notebook\clinic2"
declare LoadKeyboardLayoutA in User32 as LKL string, integer
 SET DATE GERMAN 
set dele on
      set century on
_screen.picture="d:\visual studio\vfp98\visual foxro for notebook\clinic2\all_person.jpg"

_SCREEN.Caption = 'คลินิกปัตตานีการแพทย์'
*_SCREEN.Controlbox = .F.
*ON SHUTDOWN DO PRGERR && When program error click X (close foxpro) botton 
set talk off
CLOSE DATA
SET SYSMENU TO
SET SYSMENU AUTOMATIC
public start
store .t. to start
DEFINE PAD pat OF _MSYSMENU PROMPT "คนไข้" COLOR SCHEME 3 
DEFINE PAD drug OF _MSYSMENU PROMPT "ยา" COLOR SCHEME 3 
DEFINE PAD text OF _MSYSMENU PROMPT "บทความ" COLOR SCHEME 3 
DEFINE PAD fund OF _MSYSMENU PROMPT "บัญชี" COLOR SCHEME 3 
DEFINE PAD stock OF _MSYSMENU PROMPT "สต๊อกยา" COLOR SCHEME 3 
DEFINE PAD system OF _MSYSMENU PROMPT "ระบบ" COLOR SCHEME 3 
ON PAD pat      OF _MSYSMENU ACTIVATE POPUP patpop
ON PAD drug   OF _MSYSMENU ACTIVATE POPUP drugpop
ON PAD text  OF _MSYSMENU ACTIVATE POPUP textpop
ON PAD fund OF _MSYSMENU ACTIVATE POPUP fundpop
ON PAD stock OF _MSYSMENU ACTIVATE POPUP stockpop
ON PAD system    OF _MSYSMENU ACTIVATE POPUP syspop

DEFINE POPUP patpop MARGIN RELATIVE SHADOW COLOR SCHEME 4
_screen.fontname = 'AnsanaUPC,20'
DEFINE BAR  1 OF patpop prompt 'รายการคนไข้-กด ENTER'
DEFINE BAR  2 OF patpop prompt 'เพิ่ม-แก้ไขรายชื่อคนไข้-ครั้งที่ 1'
DEFINE BAR  3 OF patpop prompt 'เพิ่มหมายเลขประจำตัวคนไข้-กด ENTER'
DEFINE BAR  4 OF patpop prompt 'พิมพ์ใบนัดคนไข้'
DEFINE BAR  5 OF patpop prompt 'บันทึกเวลาคนสแกนกับHN-อย่าลืมย้ายไฟล์มาก่อน'
DEFINE BAR  6 OF patpop prompt 'ย้ายบัตรที่scanแล้ว'
DEFINE BAR  7 OF patpop prompt  'หาคนสแกนตามเวลา'
DEFINE BAR  8 OF patpop prompt 'พิมพ์มื้ออาหาร'
DEFINE BAR  9 OF patpop prompt 'พิมพ์บัตรประจำตัวคนไข้'
DEFINE BAR 10 OF patpop prompt 'นัดผู้ป่วยฉีดยา DMPA '
DEFINE BAR 11 OF patpop prompt 'วัตถออกฤทธิ์ '
DEFINE BAR 12 OF patpop prompt 'คิดเวลาลา'


ON SELECTION BAR 1 OF patpop DO form "d:\visual studio\vfp98\visual foxro for notebook\clinic2\ptrim3.scx"
ON SELECTION BAR 2 OF patpop DO D:\zipdrive\foxpro\patout2.prg
ON SELECTION BAR 3 OF patpop DO a:\idin
ON SELECTION BAR 4 OF patpop DO FORM d:\zipdrive\foxpro\followmenu01.scx
ON SELECTION BAR 5 OF patpop DO "D:\Zipdrive\foxpro\0-File about HN_SCANNER\0-hn scanner-timedate.prg"
ON SELECTION BAR 6 OF patpop DO Form "d:\zipdrive\foxpro\0-file about hn_scanner\0-hn scanner-timedate.scx"
ON SELECTION BAR 7 OF patpop do "D:\Zipdrive\foxpro\0-File about HN_SCANNER\look_in_scanner with index_command.prg"
ON SELECTION BAR 8 OF patpop DO FORM "d:\visual studio\vfp98\visual foxro for notebook\clinic2\print_meal_drug3_pentium2.scx"
ON SELECTION BAR 9 OF patpop DO FORM "\\pentium2\pentium2-f\zipdrive\foxpro\card_label01.scx"
ON SELECTION BAR 10 OF patpop  DO FORM d:\zipdrive\foxpro\dmpa.scx
ON SELECTION BAR 11 OF patpop  DO  FORM "d:\zipdrive\foxpro\b.c.8910-notebook.scx"
ON SELECTION BAR 12 OF patpop  DO FORM  d:\zipdrive\foxpro\hour01.scx


DEFINE POPUP drugpop MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR  1 OF drugpop prompt 'เมนูเรื่องยา'
DEFINE BAR  2 OF drugpop prompt 'เพิ่ม/แก้ไขยา'
DEFINE BAR  3 OF drugpop prompt 'เพิ่ม/แก้ไขบริษัทยา'
on SELECTION BAR 1 OF drugpop DO pwd_dgen2
*on SELECTION BAR 1 OF drugpop DO form dgen2
on SELECTION BAR 2 OF drugpop DO form drugs
on SELECTION BAR 3 OF drugpop DO form addcomp



DEFINE POPUP textpop MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR  1 OF textpop prompt 'เพิ่ม-ค้นหา-แก้ไขเอกสาร'
DEFINE BAR  2 OF  textpop prompt 'เพิ่ม/แก้ไขบทความ'
ON SELECTION BAR 1 OF textpop DO form ftext
ON SELECTION BAR 2 OF textpop DO form addtext






DEFINE POPUP fundpop MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR  17 OF fundpop prompt 'โปรแกรม HN-MONEY'
ON SELECTION BAR 17 OF fundpop DO form "d:\visual studio\vfp98\visual foxro for notebook\clinic2\hn_money_3.scx"


DEFINE POPUP stockpop MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR  1 OF stockpop prompt 'เมนูสต๊อกยา'
DEFINE BAR  2 OF stockpop PROMPT 'พิมพ์รายการยาในสต๊อกทั้งหมด'
DEFINE BAR  3 OF stockpop PROMPT 'พิมพ์รายการยานอกสต๊อกทั้งหมด'
ON SELECTION BAR 1 OF stockpop DO "d:\visual studio\vfp98\visual foxro for notebook\clinic2\pwd_menu_stock.prg"
ON SELECTION BAR 2 OF stockpop do pwd_stock.prg
ON SELECTION BAR 3 OF stockpop DO  stock_2

DEFINE POPUP syspop MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR  1 OF syspop PROMPT 'เครื่องคิดเลข'
DEFINE BAR  2 OF syspop PROMPT 'ปฏิทิน '
DEFINE BAR  3 OF syspop PROMPT 'เข้าสู่ Visual Foxpro Menu'
DEFINE BAR  4 OF syspop PROMPT 'ออกจาก Foxpro..'
DEFINE BAR 7 OF syspop prompt 'วันนี้วัน '+cdow(date())+' ที่'+dtoc(date())
DEFINE BAR 17 OF syspop prompt 'ปฏิทินคลินิก'
ON SELECTION BAR 1 OF syspop ACTIVATE WINDOW calculator
ON SELECTION BAR 2 OF syspop acti window calendar
ON SELECTION BAR 3 OF syspop SET SYSMENU TO DEFAULT
ON SELECTION BAR 4 OF syspop do quit3
ON SELECTION BAR 17 OF syspop DO FORM "D:\zipdrive\foxpro\calendar1.scx"
PROCEDURE PRGERR
CLEAR EVENT
close all
clear all
on shutdown
ENDPROC